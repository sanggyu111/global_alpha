# 로컬 개발용 환경변수 예시. 복사해서 사용: cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않는다. 운영(Railway) 값은 플랫폼 환경변수로 설정한다.

# docker compose 의 PostgreSQL 계정이자 백엔드 접속 계정
DB_USERNAME=staypoint
DB_PASSWORD=change-me-local

# 백엔드 실행 프로파일 (seed: 데모 데이터 적용)
SPRING_PROFILES_ACTIVE=seed

# 모의 PG 웹훅 공유 비밀값 (X-Mock-PG-Secret). 로컬은 아무 문자열, 배포는 무작위 값으로 설정
MOCKPG_WEBHOOK_SECRET=change-me-local
